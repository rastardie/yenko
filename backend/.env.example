DATABASE_URL=postgresql://yenko:change-me@127.0.0.1:5432/yenko_development
NODE_ENV=development
AUTH_MODE=local-pin
JWT_SECRET=change-me-generate-a-long-random-value
API_HOST=127.0.0.1
API_PORT=8080

# Exact HTTPS origin(s) of the deployed PWA (e.g. a Cloudflare Pages
# domain), comma-separated, no wildcard. Required for the web client to
# call this API cross-origin at all; irrelevant to native Android/iOS,
# which are never subject to CORS. Example:
# CORS_ORIGINS=https://yenko.pages.dev,https://app.yenko.example

# Local-only header-based actor resolution, kept for isolated testing of the
# trip service without a database. Rejected outside development/test.
# AUTH_MODE=development-header

# Required when NODE_ENV=production and using OIDC instead of local-pin.
# Never commit actual provider values.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://issuer.example.com
# OIDC_AUDIENCE=yenko-api
# OIDC_ROLES_CLAIM=roles

# none | drivers | all: who must be approved by an administrator before signing in.
# SIGNUP_APPROVAL=none

# --- Email & social sign-in (all optional; each feature is dark until set) ---

# Email verification delivery. When MAIL_ENABLED is not 'true', the API returns
# the verification code in the response (dev only) instead of emailing it.
# Replace ConsoleMailSender with a real SMTP/SES sender before production.
# MAIL_ENABLED=true

# Social providers. Each is enabled only when its credentials are present.
# Tokens are verified server-side; no client secrets ship in the mobile app.
# Google: the OAuth client id(s) the app uses (comma-separated for iOS/Android/web).
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Apple: your Services ID / app bundle id (audience of the Apple ID token).
# APPLE_CLIENT_ID=com.yenko.app
# Facebook: app id + secret (used to verify access tokens via the Graph API).
# FACEBOOK_APP_ID=000000000000000
# FACEBOOK_APP_SECRET=change-me
# X (Twitter): enable verification of OAuth2 user tokens via /2/users/me.
# TWITTER_ENABLED=true

# --- WebAuthn (PWA passkeys) ---

# Both required to enable passkey registration/sign-in on the web client.
# WEBAUTHN_RP_ID must be the exact domain (no scheme/port) the PWA is served
# from, e.g. 'app.yenko.example' (or 'localhost' for local dev).
# WEBAUTHN_ORIGIN must be the exact origin the browser sends, including
# scheme and port, e.g. 'https://app.yenko.example' or 'http://localhost:8765'.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:8765
